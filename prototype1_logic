4.1 Threat Detection Algorithm (Python): This algorithm uses isolation forest to detect anomalies from sensor
data and logs them.

from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

def detect_anomaly(data: pd.DataFrame):
    scaler = StandardScaler()
    scaled_data = scaler.fit_transform(data)
    model = IsolationForest(n_estimators=100, contamination=0.01, random_state=42)
    model.fit(scaled_data)
    data['anomaly'] = model.predict(scaled_data)
    anomalies = data[data['anomaly'] == -1]
    anomalies.to_csv("anomalies_log.csv") # Save for audit trail
    return anomalies

